/* ==========================================================================
   MATRIX FINANCE — STYLE
   --------------------------------------------------------------------------
   Kolory pochodzą z motywu (src/ui/theme.py) jako zmienne $mx-*:
     $mx-accent/-mid/-dim/-dark/-deep, $mx-positive, $mx-negative, $mx-warning,
     $mx-info, $mx-transfer, $mx-bg, $mx-panel, $mx-field, $mx-field-focus,
     $mx-text, $mx-muted, $mx-faint, $mx-on-accent
   Breakpointy (klasy ekranu): -w-xs (<60) -w-sm (<100) -w-md (<150) -w-lg
                               -h-xs (<24) -h-sm (<32)  -h-md (<45)  -h-lg
   ========================================================================== */

* {
    scrollbar-size: 0 0;
    scrollbar-background: $mx-bg;
    scrollbar-background-hover: $mx-bg;
    scrollbar-color: $mx-accent-dark;
    scrollbar-color-hover: $mx-accent-dim;
    scrollbar-color-active: $mx-accent;
}

Screen { background: $mx-bg; color: $mx-text; }

.form-view, DashboardView, #dialog-body, #list-advisor { scrollbar-size-vertical: 1; }

/* ==========================================================================
   ELEMENTY OGÓLNE
   ========================================================================== */
Label { color: $mx-text; }
.hidden { display: none; }
.dim-text { color: $mx-faint; text-style: italic; }
.view-hint { color: $mx-faint; width: 100%; height: auto; padding: 0 1; }
.-h-xs .view-hint { display: none; }

.section-title {
    width: 100%;
    height: 1;
    margin: 1 0 0 0;
    padding: 0 1;
    color: $mx-accent;
    background: $mx-accent-deep;
    text-style: bold;
}
.section-title.-danger { color: $mx-negative; background: #1a0606; }

Button {
    height: 1;
    min-width: 0;
    border: none;
    padding: 0;
    color: $mx-text;
    background: $mx-field;
    text-style: bold;
}
Button:hover { background: $mx-field-focus; }
Button:focus { text-style: bold; }

.btn-primary { background: $mx-accent-dim; color: $mx-on-accent; }
.btn-primary:hover, .btn-primary:focus { background: $mx-accent; color: $mx-on-accent; }
.btn-secondary { background: $mx-field; color: $mx-text; }
.btn-secondary:hover, .btn-secondary:focus { background: $mx-field-focus; color: $mx-accent; }
.btn-danger { background: #5a0f0f; color: #ffffff; }
.btn-danger:hover, .btn-danger:focus { background: $mx-negative; color: #ffffff; }
.btn-link { background: transparent; color: $mx-accent; width: 100%; }
.btn-link:hover, .btn-link:focus { background: transparent; color: $mx-text; text-style: bold underline; }

.btn-inline { width: 1fr; background: $mx-field; color: $mx-accent; }
.btn-inline:hover, .btn-inline:focus { background: $mx-accent; color: $mx-on-accent; }
.btn-inline.-danger { color: $mx-negative; background: #1d0808; }
.btn-inline.-danger:hover, .btn-inline.-danger:focus { background: $mx-negative; color: #ffffff; }

Input { height: 1; border: none; padding: 0 1; background: $mx-field; color: $mx-text; }
Input:focus { background: $mx-field-focus; border: none; }
Input > .input--placeholder { color: $mx-faint; text-style: italic; }
Input > .input--suggestion { color: $mx-faint; }
.standard-input { margin-bottom: 1; }

Select { height: 1; }
Select > SelectCurrent { height: 1; border: none; padding: 0 1; background: $mx-field; color: $mx-text; }
Select:focus > SelectCurrent { background: $mx-field-focus; border: none; }
Select > SelectCurrent > .arrow { color: $mx-accent; }
Select > SelectOverlay { background: $mx-panel; color: $mx-text; border: round $mx-accent-dim; max-height: 14; }
Select > SelectOverlay:focus { border: round $mx-accent; }

Checkbox { height: 1; border: none; padding: 0; background: transparent; color: $mx-text; }
Checkbox:focus { background: $mx-field-focus; text-style: bold; }
Checkbox > .toggle--button, Checkbox:focus > .toggle--button { color: $mx-field-focus; background: $mx-field-focus; }
Checkbox.-on > .toggle--button, Checkbox.-on:focus > .toggle--button { color: $mx-on-accent; background: $mx-accent; }

/* Wiersze formularzy */
.form-row { width: 100%; height: 1; margin-bottom: 1; }
.-h-xs .form-row, .-h-sm .form-row { margin-bottom: 0; }
.row-label { width: 20; height: 1; padding-right: 1; text-align: right; color: $mx-muted;
             text-wrap: nowrap; text-overflow: ellipsis; }
.-w-xs .row-label { width: 13; }
.row-input { width: 1fr; }
.row-select { width: 1fr; }
.row-value { width: 1fr; height: 1; padding: 0 1; background: $mx-bg; color: $mx-text;
             text-wrap: nowrap; text-overflow: ellipsis; }
.checkbox-row Checkbox { width: 1fr; }

/* ==========================================================================
   OKNA DIALOGOWE
   ========================================================================== */
ModalScreen { align: center middle; background: rgba(0, 0, 0, 0.75); }
.dialog {
    width: 72;
    max-width: 96%;
    height: auto;
    max-height: 92%;
    background: $mx-panel;
    border: round $mx-accent;
    border-title-color: $mx-on-accent;
    border-title-background: $mx-accent;
    border-title-style: bold;
    border-subtitle-color: $mx-muted;
    border-subtitle-align: right;
    padding: 1 2 0 2;
}
.dialog.-wide { width: 92; }
.dialog.-danger { border: round $mx-negative; border-title-background: $mx-negative; border-title-color: #ffffff; }
.dialog.-info { border: round $mx-accent-mid; }
.-w-xs .dialog { padding: 0 1; }
#dialog-body { height: auto; max-height: 30; }
.-h-sm #dialog-body, .-h-xs #dialog-body { max-height: 14; }
#dialog-body .form-row { margin-bottom: 0; }
#dialog-body .row-label { width: 19; }
#dialog-error { width: 100%; height: auto; color: $mx-negative; text-style: bold; margin-top: 1; }
#dialog-buttons { width: 100%; height: 1; align: right middle; margin: 1 0; }
#dialog-buttons Button { margin-left: 2; min-width: 12; }
.dialog-note { width: 100%; height: auto; color: $mx-muted; margin-top: 1; }
#confirm-message { width: 100%; height: auto; text-align: center; text-style: bold; margin-bottom: 1; }
#confirm-dont-ask { margin-top: 1; color: $mx-muted; width: auto; }
#info-message { width: 100%; height: auto; margin-bottom: 1; }
.help-row { width: 100%; height: 1; }
#search-results { height: 16; background: $mx-bg; border: none; margin-top: 1; }
.-h-sm #search-results, .-h-xs #search-results { height: 8; }
#yk-status { width: 100%; height: auto; text-align: center; margin-bottom: 1; color: $mx-accent; }

/* ==========================================================================
   POWITANIE / LOGOWANIE
   ========================================================================== */
WelcomeScreen, LoginScreen { layers: rain ui; align: center middle; }
MatrixRain { layer: rain; position: absolute; offset: 0 0; }

.login-box {
    layer: ui;
    width: 62;
    max-width: 96%;
    height: auto;
    background: $mx-panel 92%;
    border: round $mx-accent;
    border-title-color: $mx-on-accent;
    border-title-background: $mx-accent;
    border-title-style: bold;
    padding: 1 2;
}
.-w-xs .login-box { padding: 0 1; }
.box-title { width: 100%; text-align: center; text-style: bold; color: $mx-accent; }
.box-subtitle { width: 100%; text-align: center; color: $mx-muted; margin-bottom: 1; }
#ascii-logo { width: 100%; text-align: center; color: $mx-accent; text-style: bold; }
#logo-sub { width: 100%; text-align: center; color: $mx-accent-mid; text-style: bold; margin-bottom: 1; }
.-w-xs #ascii-logo, .-h-xs #ascii-logo { display: none; }
#tagline { width: 100%; text-align: center; color: $mx-muted; margin-bottom: 1; }
#start-btn { width: 100%; background: transparent; color: $mx-accent-dim; }
#start-btn.blink, #start-btn:focus { color: $mx-accent; background: transparent; }
#login-actions, #wizard-actions {
    layout: grid; grid-size: 2; grid-columns: 1fr 1fr; grid-gutter: 0 2; height: 1; width: 100%; margin-top: 1;
}
#login-actions Button, #wizard-actions Button { width: 100%; }
#login-extra { margin-top: 1; width: 100%; height: auto; }

/* ==========================================================================
   GŁÓWNY UKŁAD
   ========================================================================== */
MainDashboard {
    layout: grid;
    grid-size: 2 2;
    grid-columns: 22 1fr;
    grid-rows: 1fr 1;
    background: $mx-bg;
}
MainDashboard.-compact { grid-size: 1 2; grid-columns: 1fr; }
MainDashboard.-compact #sidebar { display: none; }

#sidebar { row-span: 2; padding: 0 1; background: $mx-bg; border-right: vkey $mx-accent-dark; }
#app-title { width: 100%; text-align: center; color: $mx-on-accent; background: $mx-accent; text-style: bold; }
#app-version { width: 100%; text-align: center; color: $mx-faint; margin-bottom: 1; }
.-h-xs #app-version { display: none; }
.sidebar-btn { width: 100%; background: $mx-bg; color: $mx-accent; text-align: left; content-align: left middle;
               text-style: none; margin-bottom: 1; }
.-h-xs .sidebar-btn, .-h-sm .sidebar-btn { margin-bottom: 0; }
.sidebar-btn:hover { background: $mx-field; color: $mx-text; }
.sidebar-btn.active { background: $mx-accent-deep; color: $mx-text; text-style: bold; }
.sidebar-btn:focus { background: $mx-accent; color: $mx-on-accent; text-style: bold; }
.spacer { height: 1fr; }
#sidebar-hint { color: $mx-faint; width: 100%; text-align: center; }
.-h-xs #sidebar-hint, .-h-sm #sidebar-hint { display: none; }

#right-panel { width: 1fr; height: 1fr; }
#header { height: 1; width: 100%; padding: 0 1; background: $mx-bg; }
#header-title { width: 1fr; text-wrap: nowrap; text-overflow: ellipsis; }
.month-btn { background: transparent; color: $mx-accent; min-width: 3; }
.month-btn:hover { color: $mx-on-accent; background: $mx-accent; }
#header-month { width: auto; padding: 0 1; }
#header-nav { display: none; width: auto; margin-left: 2; }
MainDashboard.-compact #header-nav { display: block; }
#header-clock { width: auto; margin-left: 2; color: $mx-accent-mid; }
.-w-xs #header-title { display: none; }

#content-frame { width: 100%; height: 1fr; }
#content-frame > * { border: round $mx-accent-dark; }
#content-frame > DashboardView { border: none; }
.-h-xs #content-frame > * { border: none; }

#footer { height: 1; width: 100%; background: $mx-accent-deep; overflow: hidden; }
#footer-dynamic, #footer-static { width: auto; height: 1; }
.footer-spacer { width: 1fr; height: 1; }
.footer-btn { width: auto; height: 1; background: $mx-accent-deep; color: $mx-text; }
.footer-btn:hover { background: $mx-accent-dark; }
.footer-btn:focus { background: $mx-accent-dark; }

/* ==========================================================================
   NAGŁÓWKI WIDOKÓW / PASKI NARZĘDZI
   ========================================================================== */
.view-header { height: 1; width: 100%; padding: 0 1; background: $mx-accent-deep; margin-bottom: 1; }
.-h-xs .view-header, .-h-sm .view-header { margin-bottom: 0; }
.view-header-title { width: 1fr; color: $mx-text; text-style: bold; text-wrap: nowrap; text-overflow: ellipsis; }
.view-header-stats { width: auto; text-wrap: nowrap; }
.-w-xs .view-header-title { display: none; }

.toolbar { height: 1; width: 100%; margin-bottom: 1; }
.-h-xs .toolbar, .-h-sm .toolbar { margin-bottom: 0; }
#trans-search { width: 1fr; min-width: 10; }
#trans-cat-select, #trans-acc-select, #trans-type-select { width: 22; margin-left: 1; }
#trans-sum-label { width: auto; margin-left: 1; text-wrap: nowrap; }
TransactionsView.-narrow #trans-acc-select, TransactionsView.-narrow #trans-type-select { display: none; }
TransactionsView.-tiny #trans-cat-select { width: 14; }

/* ==========================================================================
   TABELE
   ========================================================================== */
DataTable { background: $mx-bg; color: $mx-text; border: none; }
DataTable > .datatable--header { background: $mx-accent-dark; color: $mx-text; text-style: bold; }
DataTable > .datatable--header-hover { background: $mx-accent-dim; }
DataTable > .datatable--even-row { background: $mx-bg; }
DataTable > .datatable--odd-row { background: $mx-panel; }
DataTable > .datatable--cursor { background: $mx-accent; color: $mx-on-accent; text-style: bold; }
DataTable:blur > .datatable--cursor { background: $mx-accent-dark; color: $mx-text; }
DataTable > .datatable--hover { background: $mx-accent-deep; }

#pagination-bar { height: 1; width: 100%; align: center middle; }
#page-info { width: auto; padding: 0 2; color: $mx-accent; text-style: bold; }
.page-btn { min-width: 4; margin: 0 1; background: $mx-accent-dark; }
.page-btn:hover, .page-btn:focus { background: $mx-accent; color: $mx-on-accent; }
.page-btn:disabled { background: $mx-panel; color: $mx-faint; }

AutomationView #rec-table { height: 2fr; }
AutomationView #rules-table { height: 1fr; min-height: 4; }
#rules-header { margin-top: 1; }

/* ==========================================================================
   KALENDARZ (zakładka)
   ========================================================================== */
CalendarView { layout: horizontal; }
CalendarView.-narrow { layout: vertical; }
#cal-left { width: 3fr; height: 1fr; }
#cal-right { width: 2fr; height: 1fr; margin-left: 1; }
CalendarView.-narrow #cal-left { width: 100%; height: 3fr; }
CalendarView.-narrow #cal-right { width: 100%; height: 2fr; margin-left: 0; }
#cal-main { height: 1fr; }
.cal-summary { width: 100%; height: 1; padding: 0 1; }
.cal-planned { width: 100%; height: auto; max-height: 8; padding: 0 1; }

/* ==========================================================================
   PULPIT
   ========================================================================== */
DashboardView { width: 100%; height: 100%; }
#dash-tiles { layout: grid; grid-size: 4; grid-columns: 1fr 1fr 1fr 1fr; height: auto; width: 100%; }
MainDashboard.-w-xs #dash-tiles { grid-size: 2; grid-columns: 1fr 1fr; }

.kpi-tile {
    height: auto;
    border: round $mx-accent-dim;
    border-title-color: $mx-muted;
    border-title-align: left;
    padding: 0 1;
    background: $mx-panel;
}
.kpi-value { width: 100%; text-style: bold; color: $mx-text; text-wrap: nowrap; text-overflow: ellipsis; }
.kpi-value.-pos { color: $mx-positive; }
.kpi-value.-neg { color: $mx-negative; }
.kpi-value.-warn { color: $mx-warning; }
.kpi-sub { width: 100%; color: $mx-muted; text-wrap: nowrap; text-overflow: ellipsis; }
.kpi-meter { width: 100%; }
.kpi-spark { width: 100%; height: 1; }
.-h-xs .kpi-sub, .-h-sm .kpi-sub { display: none; }
Sparkline > .sparkline--max-color { color: $mx-accent; }
Sparkline > .sparkline--min-color { color: $mx-accent-dark; }

#dash-grid {
    layout: grid;
    grid-size: 2;
    grid-columns: 1fr 1fr;
    grid-rows: 1fr 1fr 1fr;
    width: 100%;
    height: 1fr;
    min-height: 24;
}
#card-calendar { row-span: 2; }
#card-assets { display: none; }
MainDashboard.-w-lg #dash-grid { grid-size: 3; grid-columns: 1fr 1fr 1fr; grid-rows: 1fr 1fr; min-height: 18; }
MainDashboard.-w-lg #card-calendar { row-span: 1; }
MainDashboard.-w-lg #card-assets { display: block; }
MainDashboard.-w-xs #dash-grid { grid-size: 1; grid-columns: 1fr; grid-rows: auto; height: auto; }
MainDashboard.-w-xs #card-calendar { row-span: 1; height: 12; }
MainDashboard.-w-xs .dash-card { height: auto; max-height: 12; }

.dash-card {
    height: 100%;
    background: $mx-panel;
    border: round $mx-accent-dark;
    border-title-color: $mx-accent;
    border-title-style: bold;
    border-subtitle-color: $mx-muted;
    border-subtitle-align: right;
    padding: 0 1;
    overflow: hidden;
}
.card-list { width: 100%; height: 1fr; }
.card-row { width: 100%; height: 1; }
.row-name { height: 1; margin-right: 1; color: $mx-text; text-wrap: nowrap; text-overflow: ellipsis; }
.row-name-flex { width: 1fr; min-width: 6; height: 1; color: $mx-text; text-wrap: nowrap; text-overflow: ellipsis; }
.row-amount { width: auto; min-width: 9; height: 1; text-align: right; margin-left: 1; color: $mx-text; }
.row-amount.-neg { color: $mx-negative; }
.row-when { width: 9; height: 1; text-align: right; margin-left: 1; color: $mx-muted; }
.row-when.-neg { color: $mx-negative; text-style: bold; }
.row-when.-warn { color: $mx-warning; text-style: bold; }
.advice { width: 100%; height: auto; }
DashboardView.-narrow .row-amount { display: none; }

/* ==========================================================================
   RAPORTY / USTAWIENIA
   ========================================================================== */
.form-view { padding: 0 1; }
#rep-filters { height: 1; width: 100%; margin-bottom: 1; }
#rep-filters Select { width: 1fr; margin-right: 1; }
#rep-filters Button { width: auto; margin-left: 1; }
.-w-xs #rep-filters Button { display: none; }
#rep-grid, #rep-top-grid { layout: grid; grid-size: 2; grid-columns: 1fr 1fr; grid-gutter: 0 2; height: auto; }
.-w-xs #rep-grid, .-w-sm #rep-grid, .-w-xs #rep-top-grid, .-w-sm #rep-top-grid { grid-size: 1; grid-columns: 1fr; }
.rep-col { height: auto; }
.rep-col .form-row { margin-bottom: 0; }
.rep-list { height: auto; width: 100%; }
.trend-bar { width: 1fr; }
.top-bar { width: 16; }
.-w-xs .top-bar { display: none; }
SettingsView .form-row { max-width: 100; }
